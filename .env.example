# TradeTalk V2 Configuration Environment Template

# Trading Mode: PAPER, DEMO, LIVE
TRADING_MODE=PAPER

# Target Instrument & Sizing
DEFAULT_SYMBOL=XAUUSD
DEFAULT_LOT_SIZE=0.01
MIN_RR_RATIO=2.0
MAX_OPEN_POSITIONS=1

# Risk & Capital Protection
MAX_ACCOUNT_RISK_PERCENT=1.0
DAILY_LOSS_LIMIT=5.0
MAX_CONSECUTIVE_LOSSES=3

# News Windows
NEWS_PRE_BLOCK_MINUTES=30
NEWS_POST_COOLDOWN_MINUTES=15

# Multi-Agent Scoring
MIN_DECISION_SCORE=85.0
HIGH_QUALITY_SCORE=90.0

# Webhook Security
WEBHOOK_SECRET_KEY=tradetalk_v2_secret_key_884920
REQUIRE_WEBHOOK_SIGNATURE=false

# API Keys
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# cTrader Credentials
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=5908018
CTRADER_ENVIRONMENT=live
